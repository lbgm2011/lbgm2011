---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="relative w-full h-screen overflow-hidden bg-[#f3eefa]">
    <!-- Portrait photo — upper right with rounded cutout -->
    <div class="photo-container">
      <img
        src="/portrait.jpg"
        alt="Laoska Benyasca"
        class="photo"
      />
    </div>

    <!-- Content — bottom left -->
    <div class="content">
      <h1 class="site-name animate-fade-up">
        Laoska<br />Benyasca
      </h1>

      <p class="tagline animate-fade-up animate-delay-1">
        nicaraguan in lisbon<br />cats, code, adventures
      </p>

      <!-- Social icons -->
      <div class="social-row animate-fade-up animate-delay-2">
        <a href="https://github.com/lbgm2011" target="_blank" rel="noopener" class="social-icon" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
        </a>
        <a href="https://linkedin.com/in/benyasca" target="_blank" rel="noopener" class="social-icon" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="https://instagram.com/benyasca" target="_blank" rel="noopener" class="social-icon" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon">
            <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="https://tiktok.com/@thegazingfred" target="_blank" rel="noopener" class="social-icon" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="icon">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
          </svg>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<!-- Location feature hidden for now — see git history or worker/location-worker.js -->

<style>
  .photo-container {
    position: absolute;
    top: 0;
    right: 0;
    width: 55%;
    height: 70%;
    border-radius: 0 0 0 80px;
    overflow: hidden;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 75%;
  }

  .content {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 2.5rem 2.5rem;
    z-index: 10;
    max-width: 55%;
  }

  .site-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: #2a1845;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.75rem;
    color: rgba(90, 50, 140, 0.45);
    margin-top: 0.75rem;
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .social-row {
    display: flex;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .social-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(90, 50, 140, 0.1);
    background: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(90, 50, 140, 0.4);
    transition: all 0.3s;
  }

  .social-icon:hover {
    transform: scale(1.15);
    border-color: rgba(90, 50, 140, 0.3);
    background: rgba(255, 255, 255, 0.8);
    color: #2a1845;
  }

  .icon {
    width: 16px;
    height: 16px;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .photo-container {
      position: relative;
      width: 100%;
      height: 55vh;
      border-radius: 0 0 0 60px;
    }

    .content {
      position: relative;
      max-width: 100%;
      padding: 1.5rem 1.75rem 2rem;
    }

    .site-name {
      font-size: 2.75rem;
    }
  }
</style>
