---
// Footer — Minimal contact strip
const year = new Date().getFullYear();
---

<footer class="py-16 px-6 md:px-12 lg:px-24 max-w-6xl mx-auto border-t border-[var(--border-primary)] transition-colors duration-500">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
    <!-- Left -->
    <div>
      <p class="font-serif text-lg text-[var(--text-primary)] mb-1">Laoska Benyasca</p>
      <p class="font-mono text-xs text-[var(--text-faint)] tracking-wide">
        Lisbon, Portugal
      </p>
    </div>

    <!-- Links -->
    <div class="flex flex-wrap gap-8">
      <a
        href="https://github.com/lbgm2011/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs tracking-wider uppercase text-[var(--text-faint)] hover:text-[var(--text-primary)] transition-colors duration-300"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/benyasca/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs tracking-wider uppercase text-[var(--text-faint)] hover:text-[var(--text-primary)] transition-colors duration-300"
      >
        LinkedIn
      </a>
      <a
        href="mailto:laoska@benyasca.com"
        class="font-mono text-xs tracking-wider uppercase text-[var(--text-faint)] hover:text-[var(--text-primary)] transition-colors duration-300"
      >
        Email
      </a>
    </div>
  </div>

  <!-- Technical Footprint -->
  <div class="mt-12 pt-8 border-t border-[var(--border-subtle)]">
    <p class="font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--text-ghost)] mb-4">
      Technical Footprint
    </p>
    <div class="flex flex-wrap gap-8">
      <a
        href="https://pypi.org/user/Laoska.Benyasca/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs text-[var(--text-faint)] hover:text-[var(--text-primary)] transition-colors duration-300"
      >
        <span class="tracking-wider uppercase">PyPI</span>
        <span class="text-[var(--text-ghost)] mx-1">/</span>
        <span class="normal-case text-[var(--text-ghost)]">Package Distribution</span>
      </a>
      <a
        href="https://medium.com/@laoska"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs text-[var(--text-faint)] hover:text-[var(--text-primary)] transition-colors duration-300"
      >
        <span class="tracking-wider uppercase">Medium</span>
        <span class="text-[var(--text-ghost)] mx-1">/</span>
        <span class="normal-case text-[var(--text-ghost)]">Technical Writing</span>
      </a>
    </div>
  </div>

  <!-- Copyright -->
  <p class="font-mono text-[10px] text-[var(--text-ghost)] mt-12 tracking-wider">
    &copy; {year} — Built with deliberate simplicity.
  </p>
</footer>
