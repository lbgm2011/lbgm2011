---
// Engineering Pillars — Domain Mastery
const pillars = [
  {
    number: '01',
    title: 'Fintech & Insurance Evolution',
    description:
      'Entering insurance as a non-expert and architecting systems that bridge the gap between legacy industry logic and modern SaaS. Translating complex domain requirements into clean, maintainable backend services.',
    tags: ['Domain Modeling', 'Legacy Integration', 'SaaS Architecture'],
  },
  {
    number: '02',
    title: 'Integration at Scale',
    description:
      '10+ years connecting complex APIs—Stripe, Adyen, SIBS—and high-concurrency event streams to robust backends. Managing real-time state across thousands of distributed nodes using MQTT and ZMQ, with a focus on building resilience in unstable network environments.',
    tags: ['API Design', 'Payment Systems', 'Event Streams', 'MQTT/ZMQ'],
  },
  {
    number: '03',
    title: 'Architectural Trade-offs',
    description:
      'Architecture is the art of choosing what not to use. Dedicated message brokers for mission-critical persistence; lightweight tools for transient, high-speed tasks. Every decision justified by the failure mode it prevents.',
    tags: ['System Design', 'Message Brokering', 'Resilience'],
  },
];
---

<section class="py-24 md:py-32 px-6 md:px-12 lg:px-24 max-w-6xl mx-auto">
  <!-- Section header -->
  <div class="mb-20">
    <p class="font-mono text-xs tracking-[0.3em] uppercase text-[var(--text-faint)] mb-4">
      Domain Mastery
    </p>
    <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-medium text-[var(--text-primary)] tracking-tight">
      Engineering Pillars
    </h2>
  </div>

  <!-- Pillars grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 lg:gap-12">
    {pillars.map((pillar) => (
      <article class="group">
        <!-- Number -->
        <span class="font-mono text-xs text-[var(--text-ghost)] block mb-6">
          {pillar.number}
        </span>

        <!-- Divider -->
        <div class="w-full h-px bg-[var(--border-primary)] group-hover:bg-[var(--text-faint)] transition-colors duration-500 mb-8"></div>

        <!-- Title -->
        <h3 class="font-serif text-xl md:text-2xl font-medium text-[var(--text-primary)] mb-4 leading-snug">
          {pillar.title}
        </h3>

        <!-- Description -->
        <p class="text-sm leading-relaxed text-[var(--text-muted)] mb-6">
          {pillar.description}
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {pillar.tags.map((tag) => (
            <span class="font-mono text-[10px] tracking-wider uppercase text-[var(--text-faint)] border border-[var(--border-primary)] px-3 py-1 transition-colors duration-500">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
